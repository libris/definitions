<Oc%3Aoa> a :ContentGenreSubdivision ;
  :inScheme </term/kssb> ;
  :broader <%3Aoa> ;
  :code "Oc:oa" ;
  :prefLabel "sociologi"@sv ;
  :comment "Politisk sociologi betecknas Oc:oa. Politisk sociologi = studiet av det politiska systemet i relation till resten av samhället. Hit företrädesvis allmänna arb eller arb som inte kan placeras under Oa med underavd eller på annan plats i schemat."@sv .

<Oc.01> a :Subdivision ;
  :inScheme </term/kssb> ;
