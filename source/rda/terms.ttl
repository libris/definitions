<recordingtype/Digital> a :RecordingType ;
  :prefLabel "Digital"@en ;
  :prefLabel "Digital"@sv ;
  :definition "A type of recording in which the content is continuously sampled and a sequence of discrete binary values is stored to represent the amplitude of each sample in the waveform."@en ;
  :definition "Typ av inspelning i vilken innehållet löpande samplas/analyseras och en sekvens av skilda binära värden lagras för att representera varje sampels/provs amplitud i vågformen."@sv ;
  :exactMatch <http://rdaregistry.info/termList/typeRec/1002> ;
  :note "344 #a (term)" .

