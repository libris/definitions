<illustrativecontent/Facsimile> a :IllustrativeContent ;
  :prefLabel "Facsimile"@en ;
  :prefLabel "Faksimil"@sv ;
  :definition "An illustrative content that consists of an exact copy of an original, usually in the same dimensions as the original, especially of books, documents, prints, and drawings."@en ;
