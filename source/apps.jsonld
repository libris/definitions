        "featuredSearches": [
          {
            "headingByLang": {
              "sv": "Nya avhandlingar",
              "en": "New dissertations"
            },
            "findHref": "/find?_q=workCategory%3A\"saogf%3AAvhandlingar\"&_sort=-%40reverse.instanceOf.publication.librissearch%3Ayear",
            "previewParams": {
              "_q": "workCategory:\"saogf:Avhandlingar\"",
              "_limit": 20,
              "_sort": "-@reverse.instanceOf.publication.librissearch:year"
