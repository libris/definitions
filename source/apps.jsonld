        "sliceList": [
          { "dimensionChain": ["classification"], "itemLimit": 50 },
          { "dimensionChain": ["workCategory"], "itemLimit": 30 },
          { "dimensionChain": ["instanceCategory"], "itemLimit": 100 },
          { "dimensionChain": ["language"], "itemLimit": 100, "connective": "OR" },
          { "dimensionChain": ["yearPublished"], "itemLimit": 500, "range": true },
          { "dimensionChain": ["subject"], "itemLimit": 30 }
        ]
      },
      "filterAliases": [],
      "defaultTypeFilter": "\"rdf:type\":Work",
      "defaultSiteFilters": [
        { "filter": "meta.inDataset:\"https://id.kb.se/dataset/uppsok\"", "applyTo": ["Creation", "Agent"]},
        { "filter": "inScheme:\"https://id.kb.se/term/uppsok\"", "applyTo": ["Concept"] }
      ],
      "optionalSiteFilters": [],
      "relationFilters": [
        { "objectType": "Bibliography", "predicates": [ "bibliography" ] },
        { "objectType": "Agent", "predicates": [ "contributor", "subject", "publisher" ] },
        { "objectType": "Concept", "predicates": [ "subject", "workCategory", "instanceCategory", "classification" ] },
        { "objectType": "Work", "predicates": [ "subject", "isPartOf" ] },
        { "objectType": "Instance", "predicates": [ "subject", "isPartOf" ] },
        { "objectType": "Country", "predicates": [ "publicationCountry" ] }
      ]
    },
