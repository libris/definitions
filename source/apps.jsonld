      "@type": "DataService",
      "titleByLang": {"en": "LIBRIS-XL Linked Data Platform API"},
      "statistics": {
        "sliceList": [
          { "dimensionChain": ["rdf:type"], "itemLimit": 400 }
        ]
      }
    },
