    {
      "@id": "https://suecia.kb.se/data",
      "@type": "DataService",
      "titleByLang": {"en": "TODO ...... LIBRIS-XL Linked Data Platform API"},
      "statistics": {
        "sliceList": [
          { "dimensionChain": ["rdf:type"], "itemLimit": 400 }
        ]
      }
